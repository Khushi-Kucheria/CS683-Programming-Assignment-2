#include "cache.h"

// SPP: uniform strides are prefetched directly; otherwise a signature of
// recent strides predicts the next stride. Degree is scaled by accuracy.

#define IPT_ENTRIES        32
#define IP_TAG_BITS        10
#define ADDR_BITS          16
#define STRIDE_BITS        7
#define SIG_BITS           12
#define SIG_SHIFT          3
#define PT_ENTRIES         256

#define UNIFORM_CONF_MAX   3
#define UNIFORM_THRESHOLD  3
#define PT_CONF_MAX        3
#define PT_THRESHOLD       1

#define FILTER_ENTRIES     64
#define FILTER_TAG_BITS    12
#define FILTER_TAG_MASK    ((1u << FILTER_TAG_BITS) - 1)

#define EPOCH              256
#define MAX_DEGREE         4
#define MIN_DEGREE         1
#define INIT_DEGREE        2

#define IP_TAG_MASK   ((1u << IP_TAG_BITS) - 1)
#define ADDR_MASK     ((1u << ADDR_BITS) - 1)
#define SIG_MASK      ((1u << SIG_BITS) - 1)
#define STRIDE_MASK   ((1u << STRIDE_BITS) - 1)
#define STRIDE_MAX    ((1 << (STRIDE_BITS - 1)) - 1)
#define STRIDE_MIN    (-(1 << (STRIDE_BITS - 1)))

// per-IP tracking entry
struct IPT_ENTRY {
    bool     valid;
    uint32_t ip_tag;
    uint32_t last_addr;
    int32_t  last_stride;
    uint32_t uni_conf;
    uint32_t sig;
    uint32_t lru;
};

// signature -> next stride
struct PT_ENTRY {
    int32_t  stride;
    uint32_t conf;
};

// recently issued prefetches, used to measure accuracy
struct FILTER_ENTRY {
    bool     valid;
    bool     used;
    uint32_t tag;
};

static IPT_ENTRY ipt[IPT_ENTRIES];
static PT_ENTRY  pt[PT_ENTRIES];
static FILTER_ENTRY filter[FILTER_ENTRIES];

static uint32_t epoch_issued = 0;
static uint32_t epoch_useful = 0;
static uint32_t degree = INIT_DEGREE;

static uint64_t stat_issued = 0, stat_useful = 0;
static uint64_t stat_uniform_pf = 0, stat_nonuniform_pf = 0;
static uint64_t stat_degree_epochs[MAX_DEGREE + 1] = {0};

static inline uint32_t hash_ip(uint64_t ip)
{
    return (uint32_t)((ip ^ (ip >> IP_TAG_BITS) ^ (ip >> (2 * IP_TAG_BITS))) & IP_TAG_MASK);
}

static inline uint32_t update_sig(uint32_t sig, int32_t stride)
{
    return ((sig << SIG_SHIFT) ^ ((uint32_t)stride & STRIDE_MASK)) & SIG_MASK;
}

static inline uint32_t pt_index(uint32_t sig)
{
    return (sig ^ (sig >> 8)) & (PT_ENTRIES - 1);
}

static void ipt_touch(int index)
{
    for (int i = 0; i < IPT_ENTRIES; i++)
        if (ipt[i].lru < ipt[index].lru)
            ipt[i].lru++;
    ipt[index].lru = 0;
}

static inline uint32_t filter_index(uint64_t cl) { return (uint32_t)(cl & (FILTER_ENTRIES - 1)); }
static inline uint32_t filter_tag(uint64_t cl)   { return (uint32_t)((cl >> 6) & FILTER_TAG_MASK); }

static inline bool filter_hit(uint64_t cl)
{
    FILTER_ENTRY &f = filter[filter_index(cl)];
    return f.valid && f.tag == filter_tag(cl);
}

// every epoch, pick the degree based on accuracy
static void update_degree()
{
    uint32_t acc = (epoch_useful * 100) / EPOCH;

    if (acc >= 75)      degree = 4;
    else if (acc >= 50) degree = 3;
    else if (acc >= 25) degree = 2;
    else                degree = 1;

    stat_degree_epochs[degree]++;
    epoch_issued = 0;
    epoch_useful = 0;
}

void CACHE::l1d_prefetcher_initialize()
{
    std::cout << "------------------------------------------------" << std::endl;
    std::cout << "        Stride Pattern Prefetcher (SPP)         " << std::endl;
    std::cout << "------------------------------------------------" << std::endl;

    for (int i = 0; i < IPT_ENTRIES; i++) {
        ipt[i].valid = false;
        ipt[i].ip_tag = 0;
        ipt[i].last_addr = 0;
        ipt[i].last_stride = 0;
        ipt[i].uni_conf = 0;
        ipt[i].sig = 0;
        ipt[i].lru = i;
    }
    for (int i = 0; i < PT_ENTRIES; i++) {
        pt[i].stride = 0;
        pt[i].conf = 0;
    }
    for (int i = 0; i < FILTER_ENTRIES; i++) {
        filter[i].valid = false;
        filter[i].used = false;
        filter[i].tag = 0;
    }
    epoch_issued = 0;
    epoch_useful = 0;
    degree = INIT_DEGREE;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    if (type == PREFETCH)
        return;

    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;

    // demand hit on a prefetched line -> useful prefetch
    if (filter_hit(cl_addr)) {
        FILTER_ENTRY &f = filter[filter_index(cl_addr)];
        if (!f.used) {
            f.used = true;
            if (epoch_useful < 511) epoch_useful++;
            stat_useful++;
        }
    }

    uint32_t tag = hash_ip(ip);
    int index = -1;
    for (int i = 0; i < IPT_ENTRIES; i++) {
        if (ipt[i].valid && ipt[i].ip_tag == tag) { index = i; break; }
    }

    // new IP: take the LRU entry
    if (index == -1) {
        for (int i = 0; i < IPT_ENTRIES; i++)
            if (ipt[i].lru == IPT_ENTRIES - 1) { index = i; break; }

        ipt[index].valid = true;
        ipt[index].ip_tag = tag;
        ipt[index].last_addr = (uint32_t)(cl_addr & ADDR_MASK);
        ipt[index].last_stride = 0;
        ipt[index].uni_conf = 0;
        ipt[index].sig = 0;
        ipt_touch(index);
        return;
    }

    IPT_ENTRY &e = ipt[index];

    int32_t stride = (int16_t)(uint16_t)(((uint32_t)cl_addr - e.last_addr) & ADDR_MASK);

    if (stride == 0) {
        ipt_touch(index);
        return;
    }

    // stride out of range: reset this IP
    if (stride > STRIDE_MAX || stride < STRIDE_MIN) {
        e.last_addr = (uint32_t)(cl_addr & ADDR_MASK);
        e.last_stride = 0;
        e.uni_conf = 0;
        e.sig = 0;
        ipt_touch(index);
        return;
    }

    // train pattern table with the stride that followed the old signature
    if (e.sig != 0) {
        PT_ENTRY &p = pt[pt_index(e.sig)];
        if (p.stride == stride) {
            if (p.conf < PT_CONF_MAX) p.conf++;
        } else {
            if (p.conf > 0) p.conf--;
            else            p.stride = stride;
        }
    }

    // uniform confidence
    if (stride == e.last_stride) {
        if (e.uni_conf < UNIFORM_CONF_MAX) e.uni_conf++;
    } else {
        e.uni_conf = 0;
    }

    e.sig = update_sig(e.sig, stride);
    e.last_stride = stride;
    e.last_addr = (uint32_t)(cl_addr & ADDR_MASK);
    ipt_touch(index);

    uint64_t pf_cl = cl_addr;
    uint32_t lookahead_sig = e.sig;
    bool uniform = (e.uni_conf >= UNIFORM_THRESHOLD);

    for (uint32_t i = 0; i < degree; i++) {
        int32_t next_stride;

        // uniform first, else fall back to the pattern table
        if (uniform) {
            next_stride = stride;
        } else {
            PT_ENTRY &p = pt[pt_index(lookahead_sig)];
            if (p.conf < PT_THRESHOLD || p.stride == 0)
                break;
            next_stride = p.stride;
            lookahead_sig = update_sig(lookahead_sig, next_stride);
        }

        pf_cl += next_stride;
        uint64_t pf_addr = pf_cl << LOG2_BLOCK_SIZE;

        // stay within the page
        if ((pf_addr >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
            break;

        if (filter_hit(pf_cl))
            continue;

        int fill = (MSHR.occupancy < (MSHR.SIZE >> 1)) ? FILL_L1 : FILL_L2;
        if (prefetch_line(ip, addr, pf_addr, fill, 0)) {
            FILTER_ENTRY &f = filter[filter_index(pf_cl)];
            f.valid = true;
            f.used = false;
            f.tag = filter_tag(pf_cl);
            stat_issued++;
            if (uniform) stat_uniform_pf++; else stat_nonuniform_pf++;

            if (++epoch_issued >= EPOCH)
                update_degree();
        }
    }
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
    return;
}

void CACHE::l1d_prefetcher_final_stats()
{
    std::cout << "SPP final stats" << std::endl;
    std::cout << "SPP issued: " << stat_issued << "  useful: " << stat_useful;
    if (stat_issued)
        std::cout << "  accuracy: " << (100.0 * stat_useful / stat_issued) << "%";
    std::cout << std::endl;
    std::cout << "SPP uniform-mode prefetches: " << stat_uniform_pf
              << "  non-uniform-mode prefetches: " << stat_nonuniform_pf << std::endl;
    std::cout << "SPP epochs at degree 1/2/3/4: "
              << stat_degree_epochs[1] << " / " << stat_degree_epochs[2] << " / "
              << stat_degree_epochs[3] << " / " << stat_degree_epochs[4] << std::endl;
    std::cout << "SPP final degree: " << degree << std::endl;
}
