#include "cache.h"
#include <cstdlib>

#define maxRRPV 3

#define INSTR_INSERT_RRPV 0
#define DATA_INSERT_RRPV  2
#define INSTR_HIT_RRPV    0
#define DATA_HIT_RRPV     1
#define DEFAULT_INSTR_CAP 6

#define MODE_INSERTION 1
#define MODE_PROMOTION 2
#define MODE_EVICTION  4

static uint8_t l2_rrpv[NUM_CPUS][L2C_SET][L2C_WAY];
static uint8_t l2_isinstr[NUM_CPUS][L2C_SET][L2C_WAY];

static int irrip_mode = MODE_INSERTION | MODE_PROMOTION | MODE_EVICTION;
static int irrip_cap = DEFAULT_INSTR_CAP;

static uint64_t st_fill[2], st_hit[2], st_evict[2];

static int env_int(const char *name, int def)
{
    const char *s = getenv(name);
    return (s && *s) ? atoi(s) : def;
}

static int instr_lines(uint32_t cpu, uint32_t set, const BLOCK *blk, int skip_way)
{
    int n = 0;
    for (int w = 0; w < L2C_WAY; w++)
        if (w != skip_way && blk[w].valid && l2_isinstr[cpu][set][w])
            n++;
    return n;
}

void CACHE::l2c_initialize_replacement()
{
    irrip_mode = env_int("IRRIP_MODE", MODE_INSERTION | MODE_PROMOTION | MODE_EVICTION);
    irrip_cap = env_int("IRRIP_CAP", DEFAULT_INSTR_CAP);

    if (irrip_cap < 0)
        irrip_cap = 0;
    if (irrip_cap > L2C_WAY)
        irrip_cap = L2C_WAY;

    cout << "Initialize I-RRIP state for L2C (mode=" << irrip_mode
         << ", instruction cap=" << irrip_cap << " ways per set)" << endl;

    for (int c = 0; c < NUM_CPUS; c++)
        for (int i = 0; i < L2C_SET; i++)
            for (int j = 0; j < L2C_WAY; j++) {
                l2_rrpv[c][i][j] = maxRRPV;
                l2_isinstr[c][i][j] = 0;
            }
}

uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    while (1)
    {
        int data_way = -1, instr_way = -1;

        for (int w = 0; w < L2C_WAY; w++)
        {
            if (l2_rrpv[cpu][set][w] != maxRRPV)
                continue;

            if (l2_isinstr[cpu][set][w]) {
                if (instr_way < 0)
                    instr_way = w;
            }
            else {
                if (data_way < 0)
                    data_way = w;
            }
        }

        int victim = -1;

        if (data_way >= 0 && instr_way >= 0)
        {
            if (irrip_mode & MODE_EVICTION)
                victim = (instr_lines(cpu, set, current_set, -1) > irrip_cap)
                             ? instr_way
                             : data_way;
            else
                victim = (data_way < instr_way) ? data_way : instr_way;
        }
        else if (data_way >= 0)
            victim = data_way;
        else if (instr_way >= 0)
            victim = instr_way;

        if (victim >= 0)
            return victim;

        for (int w = 0; w < L2C_WAY; w++)
            l2_rrpv[cpu][set][w]++;
    }

    assert(0);
    return 0;
}

void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    if ((type == WRITEBACK) && ip)
        assert(0);

    uint8_t instr = isInstruction ? 1 : 0;

    if (hit)
    {
        if (instr)
            l2_isinstr[cpu][set][way] = 1;

        uint8_t line_is_instr = l2_isinstr[cpu][set][way];

        if (irrip_mode & MODE_PROMOTION)
        {
            if (line_is_instr)
                l2_rrpv[cpu][set][way] = INSTR_HIT_RRPV;
            else if (l2_rrpv[cpu][set][way] > DATA_HIT_RRPV)
                l2_rrpv[cpu][set][way] = DATA_HIT_RRPV;
        }
        else
            l2_rrpv[cpu][set][way] = 0;

        if (warmup_complete[cpu])
            st_hit[line_is_instr]++;
    }
    else
    {
        if (warmup_complete[cpu])
        {
            if (block[set][way].valid)
                st_evict[l2_isinstr[cpu][set][way]]++;

            st_fill[instr]++;
        }

        uint8_t rrpv = maxRRPV - 1;

        if (irrip_mode & MODE_INSERTION)
        {
            if (instr && instr_lines(cpu, set, block[set], way) < irrip_cap)
                rrpv = INSTR_INSERT_RRPV;
            else
                rrpv = DATA_INSERT_RRPV;
        }

        l2_isinstr[cpu][set][way] = instr;
        l2_rrpv[cpu][set][way] = rrpv;
    }
}

void CACHE::l2c_replacement_final_stats()
{
    cout << endl;
    cout << "L2C I-RRIP mode: " << irrip_mode
         << "  instruction cap: " << irrip_cap << endl;

    cout << "L2C I-RRIP FILLS      instruction: " << st_fill[1]
         << "  data: " << st_fill[0] << endl;

    cout << "L2C I-RRIP HITS       instruction: " << st_hit[1]
         << "  data: " << st_hit[0] << endl;

    cout << "L2C I-RRIP EVICTIONS  instruction: " << st_evict[1]
         << "  data: " << st_evict[0] << endl;
}
